{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FailedTransactionsArtifact",
  "description": "Initial (Sparta-pending) EFT json artifact produced by Taurus for browser-based tests. Mirrors error_item_skel (aggregator.py:271-279) and the DatapointSerializer three-way error split (blazemeter_reporter.py:695-717).",
  "type": "object",
  "required": ["reportInfo", "transactions"],
  "properties": {
    "reportInfo": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "sessionId": {"type": ["string", "null"]},
        "testId": {"type": ["string", "null"]},
        "timestamp": {"type": ["number", "null"]},
        "type": {"type": "string", "enum": ["FAILED_TRANSACTIONS"]}
      }
    },
    "transactions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "errors", "assertions", "failedEmbeddedResources"],
        "properties": {
          "label": {"type": "string"},
          "timestamp": {"type": ["number", "null"]},
          "duration": {"type": ["number", "null"]},
          "errors": {"type": "array", "items": {"$ref": "#/definitions/errorItem"}},
          "assertions": {"type": "array", "items": {"$ref": "#/definitions/assertionItem"}},
          "failedEmbeddedResources": {"type": "array", "items": {"$ref": "#/definitions/errorItem"}}
        }
      }
    }
  },
  "definitions": {
    "errorItem": {
      "type": "object",
      "required": ["cnt", "msg", "type"],
      "properties": {
        "cnt": {"type": "integer"},
        "msg": {"type": "string"},
        "tag": {"type": ["string", "null"]},
        "rc": {"type": ["string", "null"]},
        "type": {"type": "integer", "enum": [0, 1, 2]},
        "urls": {"type": "object"},
        "responseBodies": {"type": "array"}
      }
    },
    "assertionItem": {
      "type": "object",
      "required": ["name", "failureMessage", "failures"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "failureMessage": {"type": "string"},
        "failures": {"type": "integer"}
      }
    }
  }
}
