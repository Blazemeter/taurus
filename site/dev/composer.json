{
  "name": "blazemeter/taurus-website",
  "description": "Homepage for project Taurus, dev variant of site/composer.json using the local pwe clone",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "license": "Apache 2.0",
  "authors": [
    {
      "name": "Andrey Pokhilko",
      "email": "andrey@blazemeter.com"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "/src/pwe",
      "options": {"symlink": true, "versions": {"blazemeter/pwe": "2.0.x-dev"}}
    }
  ],
  "require": {
    "php": ">=8.3",
    "blazemeter/pwe": "^2.0",
    "easybook/geshi": "~1"
  }
}
